# Скопируйте в .env и заполните. Файл .env в git НЕ попадает.

# Ключ авторизации (Authorization key) из личного кабинета GigaChat API
GIGACHAT_CREDENTIALS=

# GIGACHAT_API_PERS — для физлиц (бесплатный тариф)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель. Список доступных: python scripts/check_access.py
GIGACHAT_MODEL=GigaChat-2

# Сертификат НУЦ Минцифры «Russian Trusted Root CA» (см. README, шаг 3)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer

# Таймаут ответа модели, секунд
GIGACHAT_TIMEOUT=30

# --- Только для проверки ошибок через фейковый сервер (scripts/fake_gigachat.py) ---
# GIGACHAT_AUTH_URL=http://127.0.0.1:8002/api/v2/oauth
# GIGACHAT_BASE_URL=http://127.0.0.1:8002/v1
